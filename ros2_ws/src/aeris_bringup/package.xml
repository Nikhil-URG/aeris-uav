<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aeris_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configuration for AERIS.</description>

  <maintainer email="nikhi.ravi@smail.inf.h-brs.de">Nikhil Ravi</maintainer>
  <license>Apache-2.0</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>aeris_flight_control</exec_depend>
  <exec_depend>aeris_mission_manager</exec_depend>
  <exec_depend>aeris_perception</exec_depend>
  <exec_depend>aeris_navigation</exec_depend>
  <exec_depend>aeris_safety</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
